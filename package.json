{
  "name": "spotify-ytm-hybrid-player",
  "version": "1.0.0",
  "description": "Static-first Spotify + YouTube Music hybrid web player with smart mixes, dynamic mood tuning, and local audio support",
  "private": true,
  "scripts": {
    "build:catalog": "node scripts/build-catalog.js",
    "build": "node scripts/build-catalog.js",
    "test": "node --test tests/*.test.js",
    "start": "node scripts/dev-server.js",
    "start:static": "python3 -m http.server 5500",
    "test:yt": "node --test tests/live/yt-smoke.live.js"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@distube/ytdl-core": "5.2.1"
  }
}
